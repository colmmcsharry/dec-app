{
  "expo": {
    "name": "Peak Performance Code",
    "slug": "daily-diesel",
    "version": "1.4.14",
    "orientation": "portrait",
    "icon": "./assets/images/logo-square.png",
    "scheme": "dailydiesel",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "buildNumber": "35",
      "bundleIdentifier": "com.colmmcs.dailydiesel",
      "deploymentTarget": "16.4",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "package": "com.colmmcs.dailydiesel",
      "versionCode": 35,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo-square.png",
        "backgroundColor": "#A8B5E0"
      },
      "predictiveBackGestureEnabled": false,
      "playStoreUrl": "https://play.google.com/store/apps/details?id=com.colmmcs.dailydiesel",
      "permissions": [
        "com.android.vending.BILLING",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon-transparent.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#E8EBF5",
          "dark": {
            "backgroundColor": "#1A1D2E"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "sounds": []
        }
      ],
      "expo-font",
      "expo-asset",
      "expo-image",
      "expo-status-bar",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true,
          "enableBackgroundRecording": false
        }
      ],
      "expo-video",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "ios": {
            "buildReactNativeFromSource": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c38ccbc7-bd1e-41a5-af70-c7db7ca2516b"
      },
      "revenueCatIosKey": "appl_bDspZSLYQkAbHSCRPuwRNZEiTFx",
      "revenueCatAndroidKey": "goog_MeqAOpmIcwvmemUbYCdCyQVkbPZ",
      "mediaBaseUrl": "",
      "pdfBaseUrl": "https://dailydiesel.netlify.app"
    }
  }
}
