{
  "expo": {
    "name": "Daily Diesel",
    "slug": "daily-diesel",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dailydiesel",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "buildNumber": "5",
      "bundleIdentifier": "com.colmmcs.dailydiesel",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#A8B5E0"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#E8EBF5",
          "dark": {
            "backgroundColor": "#1A1D2E"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-notifications",
      "expo-font",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c38ccbc7-bd1e-41a5-af70-c7db7ca2516b"
      },
      "revenueCatIosKey": "appl_bDspZSLYQkAbHSCRPuwRNZEiTFx",
      "revenueCatAndroidKey": ""
    }
  }
}
