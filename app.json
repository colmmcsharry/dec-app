{
  "expo": {
    "name": "Daily Diesel",
    "slug": "daily-diesel",
    "version": "1.3.9",
    "orientation": "portrait",
    "icon": "./assets/images/logo-square.png",
    "scheme": "dailydiesel",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "buildNumber": "12",
      "bundleIdentifier": "com.colmmcs.dailydiesel",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "package": "com.colmmcs.dailydiesel",
      "versionCode": 8,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo-square.png",
        "backgroundColor": "#A8B5E0"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "playStoreUrl": "https://play.google.com/store/apps/details?id=com.colmmcs.dailydiesel",
      "permissions": [
        "com.android.vending.BILLING",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon-transparent.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#E8EBF5",
          "dark": {
            "backgroundColor": "#1A1D2E"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "sounds": []
        }
      ],
      "expo-font",
      "expo-asset",
      "expo-video",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c38ccbc7-bd1e-41a5-af70-c7db7ca2516b"
      },
      "revenueCatIosKey": "appl_bDspZSLYQkAbHSCRPuwRNZEiTFx",
      "revenueCatAndroidKey": "goog_MeqAOpmIcwvmemUbYCdCyQVkbPZ",
      "mediaBaseUrl": "",
      "pdfBaseUrl": "https://dailydiesel.netlify.app"
    }
  }
}
