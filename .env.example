# Copy to .env.local for local Android RevenueCat testing (optional).
# On EAS, set REVENUECAT_ANDROID_KEY as a project secret instead.

REVENUECAT_ANDROID_KEY=goog_your_revenuecat_google_api_key

# Kit email signup — set on Netlify (dailydiesel site), NOT in the app.
# See docs/KIT_EMAIL_SETUP.md
# KIT_API_KEY=
# KIT_FORM_ID=
# KIT_TAG_ONBOARDING=
# KIT_TAG_ABOUT=
